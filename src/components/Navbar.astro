---
import Logo from './Logo.astro';
---

<header class="smart-navbar fixed inset-x-0 top-3 z-50 px-3" data-smart-navbar>
  <nav class="mx-auto flex max-w-7xl items-center justify-between rounded-[32px] border border-white/15 bg-[#121212]/75 px-4 py-2.5 shadow-[inset_0_1px_0_rgba(255,255,255,.16),0_18px_60px_rgba(0,0,0,.32)] backdrop-blur-2xl sm:px-5" aria-label="Main navigation">
    <div class="flex items-center gap-3">
      <Logo />
      <span class="hidden rounded-full border border-white/15 bg-white/[.04] px-3 py-1 font-mono text-[10px] text-zinc-300 sm:inline-flex">PRE-RELEASE</span>
    </div>
    <button class="inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/[.04] p-2 text-zinc-300 md:hidden" type="button" aria-expanded="false" aria-controls="primary-links" aria-label="Open navigation menu" data-menu-button>
      <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
    </button>
    <div id="primary-links" class="absolute left-3 right-3 top-[calc(100%+.65rem)] hidden rounded-[28px] border border-white/15 bg-[#121212]/95 p-5 shadow-2xl backdrop-blur-2xl md:static md:flex md:items-center md:gap-7 md:border-0 md:bg-transparent md:p-0 md:shadow-none md:backdrop-blur-none" data-menu>
      <div class="flex flex-col gap-4 text-sm text-zinc-300 md:flex-row md:items-center md:gap-7">
        <a class="transition hover:text-white" href="/#checks">What it checks</a>
        <a class="transition hover:text-white" href="/guides/">Guides</a>
        <a class="transition hover:text-white" href="/blog/">Field Notes</a>
        <a class="transition hover:text-white" href="/security/">Security</a>
      </div>
      <div class="mt-5 flex flex-col gap-3 md:mt-0 md:ml-2 md:flex-row md:items-center">
        <a class="inline-flex items-center gap-2 text-sm font-medium text-zinc-300 transition hover:text-white" href="mailto:venuuu.nyc@proton.me">Email us</a>
        <a class="inline-flex items-center justify-center gap-2 rounded-xl border border-violet-200/30 bg-gradient-to-br from-violet-300 to-violet-500 px-4 py-2 text-sm font-semibold text-zinc-950 shadow-[inset_0_1px_0_rgba(255,255,255,.4),0_8px_24px_rgba(163,163,163,.25)] transition hover:brightness-110" href="/#upgrade-audit">Start a conversation <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </nav>
</header>

<script>
  let lastScrollY = window.scrollY;
  let navbarFrame = 0;

  function initializeMenu() {
    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!menuButton || !menu || menuButton.dataset.bound === 'true') return;
    menuButton.dataset.bound = 'true';
    const closeMenu = () => {
      menu.classList.add('hidden');
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.setAttribute('aria-label', 'Open navigation menu');
    };
    menuButton.addEventListener('click', () => {
      const expanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!expanded));
      menuButton.setAttribute('aria-label', expanded ? 'Open navigation menu' : 'Close navigation menu');
      menu.classList.toggle('hidden', expanded);
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (window.matchMedia('(max-width: 767px)').matches) closeMenu();
      });
    });
  }

  function updateNavbarDirection() {
    if (navbarFrame) return;
    navbarFrame = window.requestAnimationFrame(() => {
      const currentScrollY = window.scrollY;
      const navbar = document.querySelector<HTMLElement>('[data-smart-navbar]');
      if (navbar) {
        const movingUp = currentScrollY < lastScrollY - 2;
        const nearTop = currentScrollY < 48;
        navbar.classList.toggle('navbar-hidden', movingUp && !nearTop);
      }
      lastScrollY = currentScrollY;
      navbarFrame = 0;
    });
  }

  initializeMenu();
  document.addEventListener('astro:page-load', () => {
    lastScrollY = window.scrollY;
    document.querySelector('[data-smart-navbar]')?.classList.remove('navbar-hidden');
    initializeMenu();
  });
  window.addEventListener('scroll', updateNavbarDirection, { passive: true });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (menuButton?.getAttribute('aria-expanded') === 'true') {
      menu?.classList.add('hidden');
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.setAttribute('aria-label', 'Open navigation menu');
      menuButton.focus();
    }
  });
</script>

<style>
  .smart-navbar { transition: transform .42s cubic-bezier(.2,.8,.2,1), opacity .32s ease; }
  .smart-navbar.navbar-hidden { transform: translateY(calc(-100% - 1.5rem)); opacity: 0; pointer-events: none; }
  @media (prefers-reduced-motion: reduce) { .smart-navbar { transition: none; } }
</style>
