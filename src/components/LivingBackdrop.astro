<div class="living-backdrop" aria-hidden="true">
  <canvas class="dependency-mesh" data-dependency-mesh></canvas>
  <div class="aurora-ribbon aurora-ribbon-one"></div>
  <div class="aurora-ribbon aurora-ribbon-two"></div>
  <div class="living-type">
    <div class="living-type-track">
      <span>NEXT.JS 16 <b>•</b> NO NETWORK <b>•</b> DETERMINISTIC <b>•</b> NODE 24 <b>•</b>&nbsp;</span>
      <span>NEXT.JS 16 <b>•</b> NO NETWORK <b>•</b> DETERMINISTIC <b>•</b> NODE 24 <b>•</b>&nbsp;</span>
      <span>NEXT.JS 16 <b>•</b> NO NETWORK <b>•</b> DETERMINISTIC <b>•</b> NODE 24 <b>•</b>&nbsp;</span>
      <span>NEXT.JS 16 <b>•</b> NO NETWORK <b>•</b> DETERMINISTIC <b>•</b> NODE 24 <b>•</b>&nbsp;</span>
    </div>
  </div>
</div>

<script>
  type NodePoint = { x: number; y: number; vx: number; vy: number; phase: number };
  let meshFrame = 0;
  let meshCanvas: HTMLCanvasElement | null = null;
  let meshContext: CanvasRenderingContext2D | null = null;
  let meshPoints: NodePoint[] = [];
  let viewportWidth = 0;
  let viewportHeight = 0;
  let deviceScale = 1;
  const pointer = { x: -1000, y: -1000, targetX: -1000, targetY: -1000 };
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Touch screens have no cursor to follow, so the mesh drifts at 30 fps there: half the work, and
  // the drift is slow enough that nobody sees the difference.
  const touchOnly = window.matchMedia('(hover: none)');
  // Mobile browsers change the viewport height as the address bar shows and hides. The canvas is
  // drawn this much taller so those resizes don't reallocate it or reseed the mesh mid-scroll.
  const HEIGHT_HEADROOM = 160;
  let lastDraw = 0;
  let scrolling = false;
  let scrollTimer = 0;

  function resizeMesh() {
    if (!meshCanvas || !meshContext) return;
    const width = window.innerWidth;
    const height = window.innerHeight + HEIGHT_HEADROOM;
    if (meshPoints.length > 0 && width === viewportWidth && Math.abs(height - viewportHeight) <= HEIGHT_HEADROOM) return;
    viewportWidth = width;
    viewportHeight = height;
    deviceScale = Math.min(window.devicePixelRatio || 1, 1.5);
    meshCanvas.width = Math.round(viewportWidth * deviceScale);
    meshCanvas.height = Math.round(viewportHeight * deviceScale);
    meshCanvas.style.width = `${viewportWidth}px`;
    meshCanvas.style.height = `${viewportHeight}px`;
    meshContext.setTransform(deviceScale, 0, 0, deviceScale, 0, 0);
    const count = Math.max(28, Math.min(58, Math.round(viewportWidth * viewportHeight / 22000)));
    meshPoints = Array.from({ length: count }, () => ({
      x: Math.random() * viewportWidth,
      y: Math.random() * viewportHeight,
      vx: (Math.random() - .5) * .16,
      vy: (Math.random() - .5) * .16,
      phase: Math.random() * Math.PI * 2,
    }));
    drawMesh(0, false);
  }

  function drawMesh(time: number, animate: boolean) {
    if (!meshContext) return;
    const context = meshContext;
    context.clearRect(0, 0, viewportWidth, viewportHeight);
    pointer.x += (pointer.targetX - pointer.x) * .045;
    pointer.y += (pointer.targetY - pointer.y) * .045;

    meshPoints.forEach((point) => {
      if (animate) {
        point.x += point.vx + (pointer.x - point.x) * .000018;
        point.y += point.vy + (pointer.y - point.y) * .000018;
        if (point.x < -12) point.x = viewportWidth + 12;
        if (point.x > viewportWidth + 12) point.x = -12;
        if (point.y < -12) point.y = viewportHeight + 12;
        if (point.y > viewportHeight + 12) point.y = -12;
        point.phase += .004;
      }
    });

    const reach = Math.min(154, Math.max(108, viewportWidth * .115));
    for (let index = 0; index < meshPoints.length; index += 1) {
      const point = meshPoints[index];
      if (!point) continue;
      const glow = .18 + (Math.sin(point.phase + time * .0002) + 1) * .08;
      context.fillStyle = `rgba(212,212,212,${glow})`;
      context.beginPath();
      context.arc(point.x, point.y, 1.05, 0, Math.PI * 2);
      context.fill();
      for (let nextIndex = index + 1; nextIndex < meshPoints.length; nextIndex += 1) {
        const next = meshPoints[nextIndex];
        if (!next) continue;
        const dx = point.x - next.x;
        const dy = point.y - next.y;
        const distance = Math.sqrt(dx * dx + dy * dy);
        if (distance < reach) {
          context.strokeStyle = `rgba(212,212,212,${(1 - distance / reach) * .13})`;
          context.lineWidth = .65;
          context.beginPath();
          context.moveTo(point.x, point.y);
          context.lineTo(next.x, next.y);
          context.stroke();
        }
      }
      const cursorDistance = Math.hypot(point.x - pointer.x, point.y - pointer.y);
      if (cursorDistance < 170) {
        context.strokeStyle = `rgba(212,212,212,${(1 - cursorDistance / 170) * .28})`;
        context.lineWidth = .8;
        context.beginPath();
        context.moveTo(point.x, point.y);
        context.lineTo(pointer.x, pointer.y);
        context.stroke();
      }
    }
  }

  function canAnimate() {
    return !prefersReducedMotion.matches && document.visibilityState === 'visible' && !scrolling;
  }

  function tick(time: number) {
    meshFrame = 0;
    if (!canAnimate()) return;
    if (!touchOnly.matches || time - lastDraw >= 32) {
      drawMesh(time, true);
      lastDraw = time;
    }
    meshFrame = window.requestAnimationFrame(tick);
  }

  function resume() {
    if (meshFrame === 0 && canAnimate()) meshFrame = window.requestAnimationFrame(tick);
  }

  function startMesh() {
    meshCanvas = document.querySelector<HTMLCanvasElement>('[data-dependency-mesh]');
    meshContext = meshCanvas?.getContext('2d', { alpha: true }) ?? null;
    if (!meshCanvas || !meshContext) return;
    window.cancelAnimationFrame(meshFrame);
    meshFrame = 0;
    meshPoints = [];
    resizeMesh();
    resume();
  }

  window.addEventListener('resize', resizeMesh, { passive: true });
  // The mesh sits still while the page scrolls, so scrolling never competes with it for frames.
  window.addEventListener('scroll', () => {
    scrolling = true;
    window.cancelAnimationFrame(meshFrame);
    meshFrame = 0;
    window.clearTimeout(scrollTimer);
    scrollTimer = window.setTimeout(() => {
      scrolling = false;
      resume();
    }, 180);
  }, { passive: true });
  window.addEventListener('pointermove', (event) => {
    pointer.targetX = event.clientX;
    pointer.targetY = event.clientY;
    const card = (event.target as Element | null)?.closest<HTMLElement>('.spotlight-card');
    if (card) {
      const bounds = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${event.clientX - bounds.left}px`);
      card.style.setProperty('--mouse-y', `${event.clientY - bounds.top}px`);
    }
  }, { passive: true });
  window.addEventListener('pointerout', (event) => {
    if (event.relatedTarget) return;
    pointer.targetX = -1000;
    pointer.targetY = -1000;
  }, { passive: true });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') {
      window.cancelAnimationFrame(meshFrame);
      meshFrame = 0;
    } else startMesh();
  });
  prefersReducedMotion.addEventListener('change', startMesh);
  startMesh();
  document.addEventListener('astro:page-load', startMesh);
</script>

<style>
  .living-backdrop { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; background: #0a0a0a; contain: strict; }
  .dependency-mesh { position: absolute; inset: 0; opacity: .8; }
  /* The glows are soft gradients the compositor only moves: no live blur and no blend mode, which
     redrew a full-screen blur on every frame and made phones drop to about 20 fps. --spread stands
     in for the old blur radius, so the glow covers the same area. */
  .aurora-ribbon { --spread: 130px; position: absolute; width: calc(65vw + 2 * var(--spread)); height: calc(55vh + 2 * var(--spread)); opacity: .125; will-change: transform; animation: aurora-drift 23s ease-in-out infinite alternate; }
  .aurora-ribbon-one { top: calc(-24vh - var(--spread)); left: calc(-12vw - var(--spread)); background: radial-gradient(closest-side, rgba(163,163,163,.5), rgba(163,163,163,.36) 30%, rgba(163,163,163,.16) 60%, rgba(163,163,163,.04) 82%, rgba(163,163,163,0)); }
  .aurora-ribbon-two { right: calc(-24vw - var(--spread)); bottom: calc(-34vh - var(--spread)); background: radial-gradient(closest-side, rgba(163,163,163,.66), rgba(163,163,163,.48) 30%, rgba(163,163,163,.21) 60%, rgba(163,163,163,.05) 82%, rgba(163,163,163,0)); animation-duration: 29s; animation-direction: alternate-reverse; }
  .living-type { position: absolute; top: 50%; left: 0; width: 100%; overflow: hidden; transform: translateY(-50%); color: rgba(240,240,240,.03); font-family: var(--font-display), sans-serif; font-size: clamp(3.5rem, 11vw, 11rem); font-weight: 700; letter-spacing: -.07em; line-height: .85; white-space: nowrap; }
  .living-type-track { display: flex; width: max-content; animation: living-type-loop 220s linear infinite; will-change: transform; }
  @keyframes living-type-loop { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-50%, 0, 0); } }
  .living-type b { color: rgba(212,212,212,.12); font-size: .5em; vertical-align: 18%; }
  @keyframes aurora-drift { from { transform: translate3d(-4vw,-2vh,0) rotate(-8deg) scale(1); } to { transform: translate3d(8vw,5vh,0) rotate(9deg) scale(1.13); } }
  @media (max-width: 700px) { .aurora-ribbon { --spread: 95px; width: calc(110vw + 2 * var(--spread)); height: calc(40vh + 2 * var(--spread)); opacity: .095; } .living-type { font-size: 18vw; } }
  @media (prefers-reduced-motion: reduce) { .aurora-ribbon, .living-type-track { animation: none; transition: none; } }
</style>
