<script>
  const activeSocialKey = 'neukee-active-social';
  function restoreActiveSocial() {
    try {
      const active = localStorage.getItem(activeSocialKey);
      document.querySelectorAll<HTMLElement>('[data-social]').forEach((item) => {
        item.classList.toggle('is-active', item.dataset.social === active);
      });
    } catch (error) {
      console.error('Unable to restore the saved social link highlight.', error);
    }
  }
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    const social = target?.closest<HTMLElement>('[data-social]');
    const socialName = social?.dataset.social;
    if (!social || !socialName) return;
    document.querySelectorAll<HTMLElement>('[data-social]').forEach((item) => item.classList.remove('is-active'));
    social.classList.add('is-active');
    try {
      localStorage.setItem(activeSocialKey, socialName);
    } catch (error) {
      console.error('Unable to save the selected social link highlight.', error);
    }
  });
  restoreActiveSocial();
  document.addEventListener('astro:page-load', restoreActiveSocial);
</script>
