---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  published?: string;
}

const { title, description, canonicalPath, published = '2026-11-23' } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published,
  dateModified: published,
  author: { '@type': 'Organization', name: 'Neukee', url: 'https://neukee.github.io' },
  publisher: { '@type': 'Organization', name: 'Neukee', url: 'https://neukee.github.io' },
  mainEntityOfPage: `https://neukee.github.io${canonicalPath}`,
};
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} ogType="article" {jsonLd}>
  <div class="mx-auto max-w-7xl px-5 py-12 lg:px-8 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_250px]">
      <article class="min-w-0">
        <a href="/guides/" class="font-mono text-xs text-emerald-300 hover:text-emerald-200">← ALL UPGRADE GUIDES</a>
        <header class="mb-10 mt-6 border-b border-zinc-800 pb-8" data-reveal>
          <p class="font-mono text-xs uppercase tracking-[.2em] text-zinc-500">Engineering field guide · Updated {published}</p>
          <h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-tight text-zinc-50 sm:text-5xl">{title}</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-zinc-400">{description}</p>
        </header>
        <div class="prose-technical max-w-none" data-reveal><slot /></div>
        <aside class="glass-surface mt-14 rounded-2xl p-7 sm:p-9" data-reveal>
          <p class="font-mono text-xs uppercase tracking-[.18em] text-emerald-300">Move from guesswork to evidence</p>
          <h2 class="mt-3 text-2xl font-semibold text-zinc-50">Know your blockers before the upgrade PR.</h2>
          <p class="mt-3 max-w-2xl leading-7 text-zinc-400">Neukee scans runtime settings, lockfiles, and application behavior to make upgrade risks reviewable. Start with the open-source project or request a guided fleet readiness audit.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a class="rounded-md bg-violet-400 px-4 py-2.5 text-sm font-semibold text-zinc-950 hover:bg-violet-300" href="https://github.com/neukee/neukee" target="_blank" rel="noreferrer">Explore Neukee on GitHub</a>
            <a class="rounded-md border border-zinc-700 px-4 py-2.5 text-sm font-semibold text-zinc-200 hover:border-violet-300/50" href="/#fleet-audit">Request a fleet audit</a>
          </div>
        </aside>
      </article>
      <aside class="order-first lg:order-last">
        <div class="top-28 rounded-xl border border-zinc-800 bg-surface p-5 lg:sticky">
          <p class="font-mono text-[11px] uppercase tracking-[.18em] text-zinc-500">On this page</p>
          <nav class="mt-4 space-y-3 text-sm text-zinc-400" aria-label="Table of contents">
            <slot name="toc" />
          </nav>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
