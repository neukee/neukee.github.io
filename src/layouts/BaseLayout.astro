---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LivingBackdrop from '../components/LivingBackdrop.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const { title, description, canonicalPath = Astro.url.pathname, ogType = 'website', jsonLd } = Astro.props;
const canonical = new URL(canonicalPath, 'https://neukee.github.io').toString();
const organizationSchema = {
  '@type': 'Organization',
  name: 'Neukee',
  url: 'https://neukee.github.io',
  logo: 'https://neukee.github.io/neukee-logo-mark.png',
  email: 'venuuu.nyc@proton.me',
};
const applicationSchema = {
  '@type': 'SoftwareApplication',
  name: 'Neukee',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS',
  description,
  url: 'https://neukee.github.io',
  codeRepository: 'https://github.com/neukee/neukee',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
};
const pageSchemaNodes = jsonLd
  ? (() => {
      const { ['@context']: context, ...pageSchema } = jsonLd;
      void context;
      return [pageSchema];
    })()
  : [];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [organizationSchema, applicationSchema, ...pageSchemaNodes],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#08070b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Neukee" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://neukee.github.io/og-preview.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://neukee.github.io/og-preview.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="relative isolate min-h-screen bg-transparent font-sans text-zinc-50 antialiased selection:bg-violet-500/30">
    <a class="sr-only fixed left-4 top-4 z-[100] rounded bg-violet-300 px-4 py-2 font-semibold text-zinc-950 focus:not-sr-only" href="#main-content">Skip to content</a>
    <LivingBackdrop />
    <div class="relative z-10">
      <Navbar />
      <main id="main-content"><slot /></main>
      <Footer />
    </div>
  </body>
</html>

<script>
  let revealObserver: IntersectionObserver | undefined;

  function initializeReveal() {
    revealObserver?.disconnect();
    const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      document.documentElement.classList.remove('js-motion');
      items.forEach((item) => item.classList.add('is-visible'));
      return;
    }

    document.documentElement.classList.add('js-motion');
    revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -36px 0px' });
    items.forEach((item) => {
      item.classList.remove('is-visible');
      revealObserver?.observe(item);
    });
  }

  let lastScrollY = window.scrollY;
  let marqueeShift = 0;
  let scrollFramePending = false;
  function updateScrollMarquee() {
    if (scrollFramePending || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    scrollFramePending = true;
    window.requestAnimationFrame(() => {
      const currentScrollY = window.scrollY;
      marqueeShift -= (currentScrollY - lastScrollY) * 0.22;
      lastScrollY = currentScrollY;
      document.querySelectorAll<HTMLElement>('[data-scroll-marquee]').forEach((track) => {
        const cycleWidth = track.scrollWidth / 2;
        const shift = cycleWidth ? ((marqueeShift % cycleWidth) + cycleWidth) % cycleWidth : marqueeShift;
        track.style.setProperty('--scroll-shift', `${shift}px`);
      });
      document.querySelectorAll<HTMLElement>('[data-living-type]').forEach((typeLayer) => {
        typeLayer.style.setProperty('--scroll-shift', `${marqueeShift * .35}px`);
      });
      updateStackSlides();
      scrollFramePending = false;
    });
  }

  function updateStackSlides() {
    const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-stack-slide]'));
    slides.forEach((slide, index) => {
      const next = slides[index + 1];
      if (!next) {
        slide.style.setProperty('--stack-progress', '0');
        return;
      }
      const nextTop = next.getBoundingClientRect().top;
      const progress = Math.max(0, Math.min(1, (window.innerHeight * .84 - nextTop) / (window.innerHeight * .52)));
      slide.style.setProperty('--stack-progress', String(progress));
    });
  }

  function initializeSpotlights() {
    document.querySelectorAll<HTMLElement>('main article, main .glass-surface, main button, footer .social-squircle').forEach((item) => {
      item.classList.add('spotlight-card');
    });
  }

  initializeReveal();
  initializeSpotlights();
  document.addEventListener('astro:page-load', () => {
    lastScrollY = window.scrollY;
    initializeReveal();
    initializeSpotlights();
    updateStackSlides();
  });
  window.addEventListener('scroll', updateScrollMarquee, { passive: true });
</script>

<style is:global>
  :root { color-scheme: dark; --font-display: "Space Grotesk"; --font-sans: "Inter"; --font-mono: "JetBrains Mono"; }
  html { scroll-padding-top: 6rem; scroll-behavior: smooth; background: #08070b; }
  body { margin: 0; }
  h1, h2, h3, h4, h5, h6 { font-family: var(--font-display), Inter, ui-sans-serif, system-ui, sans-serif; text-wrap: balance; letter-spacing: -.02em; }
  h1 { letter-spacing: -.035em; }
  ::selection { color: #f5f3ff; }
  :focus-visible { outline: 2px solid #a78bfa; outline-offset: 3px; }
  html.js-motion [data-reveal] { opacity: 0; transform: translateY(20px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
  html.js-motion [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  .glass-surface, .bg-surface { border: 1px solid rgba(255,255,255,.12); background: linear-gradient(145deg, rgba(255,255,255,.085), rgba(255,255,255,.025)); box-shadow: inset 0 1px 0 rgba(255,255,255,.16), 0 24px 80px rgba(0,0,0,.32); backdrop-filter: blur(24px) saturate(200%); }
  .rounded-xl, .rounded-2xl, .rounded-lg, .rounded-md { border-radius: 2rem; }
  .rounded-full { border-radius: 9999px; }
  :is(article, .glass-surface, .bg-surface, .spotlight-card) { position: relative; isolation: isolate; overflow: hidden; border-color: rgba(255,255,255,.14); box-shadow: inset 0 1px 0 rgba(255,255,255,.16), 0 24px 80px rgba(0,0,0,.24); }
  :is(article, .glass-surface, .bg-surface, .spotlight-card)::after { position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: radial-gradient(320px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(167,139,250,.19), transparent 68%); content: ""; opacity: 0; pointer-events: none; transition: opacity .25s ease; }
  :is(article, .glass-surface, .bg-surface, .spotlight-card):hover::after { opacity: 1; }
  main :is(section, article, div)[class*="bg-[#"] { border-color: rgba(255,255,255,.13); background: linear-gradient(145deg, rgba(255,255,255,.075), rgba(17,16,24,.72) 58%, rgba(124,58,237,.045)) !important; box-shadow: inset 0 1px 0 rgba(255,255,255,.13), 0 22px 65px rgba(0,0,0,.2); backdrop-filter: blur(24px) saturate(180%); }
  button { border-radius: 1.25rem; box-shadow: inset 0 1px 0 rgba(255,255,255,.12); backdrop-filter: blur(18px) saturate(170%); transition: transform .2s ease, box-shadow .25s ease, border-color .25s ease; }
  :is(input, select, textarea) { border-radius: 1.25rem !important; border-color: rgba(255,255,255,.15) !important; background: linear-gradient(145deg, rgba(255,255,255,.075), rgba(0,0,0,.24)) !important; box-shadow: inset 0 1px 0 rgba(255,255,255,.1); backdrop-filter: blur(18px) saturate(170%); }
  .social-squircle { position: relative; display: inline-flex; height: 46px; width: 46px; align-items: center; justify-content: center; overflow: hidden; border: 1px solid rgba(255,255,255,.15); border-radius: 17px; background: linear-gradient(145deg, rgba(255,255,255,.17), rgba(255,255,255,.035)); box-shadow: inset 0 1px 0 rgba(255,255,255,.24), 0 8px 26px rgba(0,0,0,.3); backdrop-filter: blur(20px) saturate(180%); color: #e4e4e7; transition: transform .2s ease, box-shadow .25s ease, background .25s ease; }
  .social-squircle svg { height: 19px; width: 19px; fill: currentColor; }
  .social-squircle:hover { transform: translateY(-2px); color: white; }
  .social-squircle.is-active { border-color: rgba(56,189,248,.7); background: linear-gradient(145deg, #0A84FF, #38BDF8); box-shadow: inset 0 1px 0 rgba(255,255,255,.44), 0 0 28px rgba(10,132,255,.48); color: white; }
  .social-squircle.is-active::before { position: absolute; inset: -60% -30%; background: linear-gradient(110deg, transparent 38%, rgba(255,255,255,.75) 49%, transparent 60%); content: ""; transform: translateX(-100%); animation: shineSweep .8s ease-out; }
  .social-squircle.is-active svg { position: relative; z-index: 2; }
  @keyframes shineSweep { to { transform: translateX(100%); } }
  :is(a, button)[class*="bg-violet-400"], :is(a, button)[class*="bg-emerald-500"] { position: relative; isolation: isolate; overflow: hidden; border: 1px solid rgba(255,255,255,.28); box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 10px 32px rgba(124,58,237,.25); transition: transform .2s ease, box-shadow .25s ease, filter .25s ease; }
  :is(a, button)[class*="bg-violet-400"]::before, :is(a, button)[class*="bg-emerald-500"]::before { position: absolute; inset: -100% -30%; z-index: -1; background: linear-gradient(110deg, transparent 44%, rgba(255,255,255,.42) 50%, transparent 56%); content: ""; transform: translateX(-55%); transition: transform .7s ease; }
  :is(a, button)[class*="bg-violet-400"]:hover::before, :is(a, button)[class*="bg-emerald-500"]:hover::before { transform: translateX(55%); }
  :is(a, button)[class*="bg-violet-400"]:hover, :is(a, button)[class*="bg-emerald-500"]:hover { box-shadow: inset 0 1px 0 rgba(255,255,255,.38), 0 14px 42px rgba(124,58,237,.36); filter: saturate(1.15); }
  :is(a, button)[class*="bg-violet-400"]:active, :is(a, button)[class*="bg-emerald-500"]:active, button:active { transform: scale(.96); }
  .stack-stage { position: relative; min-height: calc(100svh + 5rem); padding-bottom: 5rem; }
  .stack-slide { position: sticky; top: 5.25rem; z-index: var(--stack-order, 1); border-radius: 2rem; transform: scale(calc(1 - var(--stack-progress, 0) * .05)); transform-origin: top center; filter: brightness(calc(1 - var(--stack-progress, 0) * .12)); transition: transform .12s linear, filter .12s linear; }
  @media (prefers-reduced-motion: reduce) { .stack-slide { transform: none; filter: none; } }
  .eyebrow { font-family: "JetBrains Mono", monospace; font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: #c4b5fd; }
  .display-outline { color: transparent; -webkit-text-stroke: 1.5px rgba(196,181,253,.92); }
  .dot-field { background-image: radial-gradient(rgba(196,181,253,.23) .8px, transparent .8px); background-size: 24px 24px; }
  .scroll-marquee-track { display: flex; width: max-content; transform: translate3d(var(--scroll-shift, 0px), 0, 0); will-change: transform; }
  .scroll-marquee-copy { display: flex; flex: none; align-items: center; gap: clamp(1.5rem, 5vw, 5rem); padding-right: clamp(1.5rem, 5vw, 5rem); white-space: nowrap; }
  .scroll-marquee-copy span { font-family: "Space Grotesk", sans-serif; font-size: clamp(2.4rem, 8vw, 7rem); font-weight: 700; letter-spacing: -.075em; line-height: .9; }
  .scroll-marquee-copy .stroke { color: transparent; -webkit-text-stroke: 1.3px rgba(196,181,253,.72); }
  ::view-transition-old(root) { animation: page-out .24s cubic-bezier(.7,0,.84,0) both; }
  ::view-transition-new(root) { animation: page-in .48s cubic-bezier(.2,.8,.2,1) both; }
  @keyframes page-in { from { opacity: 0; transform: translateX(26px); filter: hue-rotate(-35deg) saturate(.75); } to { opacity: 1; transform: translateX(0); filter: hue-rotate(0) saturate(1); } }
  @keyframes page-out { to { opacity: 0; transform: translateX(-18px); filter: hue-rotate(35deg) saturate(1.15); } }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto !important; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
  }
  .prose-technical h2 { margin-top: 3rem; scroll-margin-top: 6rem; font-size: 1.7rem; font-weight: 650; letter-spacing: -.025em; color: #fafafa; }
  .prose-technical h3 { margin-top: 2rem; font-size: 1.2rem; font-weight: 600; color: #e4e4e7; }
  .prose-technical p, .prose-technical li { color: #a1a1aa; line-height: 1.8; }
  .prose-technical p { margin-top: 1rem; }
  .prose-technical ul, .prose-technical ol { margin: 1rem 0; padding-left: 1.4rem; }
  .prose-technical li { margin: .45rem 0; }
  .prose-technical li::marker { color: #a78bfa; }
  .prose-technical a { color: #c4b5fd; text-decoration: underline; text-underline-offset: 3px; }
  .prose-technical :not(pre) > code { border: 1px solid rgba(255,255,255,.12); border-radius: .75rem; background: linear-gradient(145deg, rgba(255,255,255,.09), rgba(255,255,255,.035)); padding: .12rem .4rem; font-family: var(--font-mono), monospace; font-size: .88em; color: #e4e4e7; }
  .prose-technical pre { overflow-x: auto; margin: 1.25rem 0; border: 1px solid rgba(255,255,255,.12); border-radius: 1.5rem; background: linear-gradient(145deg, rgba(255,255,255,.07), rgba(8,7,11,.82)); padding: 1.25rem; font-family: var(--font-mono), monospace; font-size: .82rem; line-height: 1.75; color: #d4d4d8; box-shadow: inset 0 1px 0 rgba(255,255,255,.12), 0 18px 50px rgba(0,0,0,.2); }
  .prose-technical pre code { font: inherit; }
  .prose-technical table { width: 100%; margin: 1.5rem 0; border: 1px solid rgba(255,255,255,.12); border-collapse: separate; border-spacing: 0; border-radius: 1.25rem; overflow: hidden; background: linear-gradient(145deg, rgba(255,255,255,.06), rgba(255,255,255,.015)); font-size: .92rem; }
  .prose-technical th, .prose-technical td { border: 1px solid #27272a; padding: .75rem; text-align: left; vertical-align: top; }
  .prose-technical th { background: #18181b; color: #e4e4e7; }
  .prose-technical td { color: #a1a1aa; }
</style>
