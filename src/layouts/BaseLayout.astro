---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LivingBackdrop from '../components/LivingBackdrop.astro';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import { CONTACT_EMAIL, GOOGLE_SITE_VERIFICATION, PROFILES } from '../site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, canonicalPath = Astro.url.pathname, ogType = 'website', jsonLd, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://neukee.github.io');
const canonical = new URL(canonicalPath, site).toString();
const ogImage = new URL('/brand/og.png', site).toString();
const organizationSchema = {
  '@type': 'Organization',
  '@id': new URL('/#organization', site).toString(),
  name: 'Neukee',
  url: site.toString(),
  logo: new URL('/brand/neukee-logo-512.png', site).toString(),
  email: CONTACT_EMAIL,
  sameAs: Object.values(PROFILES),
};
const websiteSchema = {
  '@type': 'WebSite',
  '@id': new URL('/#website', site).toString(),
  name: 'Neukee',
  url: site.toString(),
  publisher: { '@id': new URL('/#organization', site).toString() },
};
const applicationSchema = {
  '@type': 'SoftwareApplication',
  name: 'Neukee',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  description: 'Open-source, local-first scanner that finds what breaks before you upgrade Node.js or Next.js. Pre-release; version 0.1.0 is planned for December 8, 2026.',
  url: site.toString(),
  codeRepository: PROFILES.github,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  isAccessibleForFree: true,
  publisher: { '@id': new URL('/#organization', site).toString() },
};
// A page can pass one schema.org node or a { '@graph': [...] } of several.
const pageSchemaNodes = jsonLd
  ? (() => {
      const { ['@context']: context, ...pageSchema } = jsonLd;
      void context;
      const graph = (pageSchema as { '@graph'?: unknown[] })['@graph'];
      return Array.isArray(graph)
        ? graph.map((node) => {
            const { ['@context']: nodeContext, ...rest } = node as Record<string, unknown>;
            void nodeContext;
            return rest;
          })
        : [pageSchema];
    })()
  : [];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [organizationSchema, websiteSchema, applicationSchema, ...pageSchemaNodes],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Neukee" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Neukee: know what breaks before you upgrade Node.js or Next.js." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@neukee4dev" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="relative isolate min-h-screen bg-transparent font-sans text-zinc-50 antialiased selection:bg-violet-500/30">
    <a class="sr-only fixed left-4 top-4 z-[100] rounded bg-violet-300 px-4 py-2 font-semibold text-zinc-950 focus:not-sr-only" href="#main-content">Skip to content</a>
    <LivingBackdrop />
    <div class="relative z-10">
      <Navbar />
      <main id="main-content"><slot /></main>
      <Footer />
    </div>
  </body>
</html>

<script>
  let revealObserver: IntersectionObserver | undefined;

  function initializeReveal() {
    revealObserver?.disconnect();
    const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      document.documentElement.classList.remove('js-motion');
      items.forEach((item) => item.classList.add('is-visible'));
      return;
    }

    document.documentElement.classList.add('js-motion');
    revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -36px 0px' });
    items.forEach((item) => {
      item.classList.remove('is-visible');
      revealObserver?.observe(item);
    });
  }

  function initializeSpotlights() {
    document.querySelectorAll<HTMLElement>('main article, main .glass-surface, main button, footer .social-squircle').forEach((item) => {
      item.classList.add('spotlight-card');
    });
  }

  initializeReveal();
  initializeSpotlights();
  document.addEventListener('astro:page-load', () => {
    initializeReveal();
    initializeSpotlights();
  });
</script>

<style is:global>
  :root { color-scheme: dark; --font-display: "Space Grotesk Variable"; --font-sans: "Inter Variable"; --font-mono: "JetBrains Mono Variable"; }
  html { scroll-padding-top: 6rem; scroll-behavior: smooth; background: #0a0a0a; }
  body { margin: 0; }
  h1, h2, h3, h4, h5, h6 { font-family: var(--font-display), Inter, ui-sans-serif, system-ui, sans-serif; text-wrap: balance; letter-spacing: -.02em; }
  h1 { letter-spacing: -.035em; }
  ::selection { color: #fafafa; }
  :focus-visible { outline: 2px solid #d4d4d4; outline-offset: 3px; }
  html.js-motion [data-reveal] { opacity: 0; transform: translateY(20px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
  html.js-motion [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  .glass-surface, .bg-surface { border: 1px solid rgba(255,255,255,.12); background: linear-gradient(145deg, rgba(255,255,255,.085), rgba(255,255,255,.025)); box-shadow: inset 0 1px 0 rgba(255,255,255,.16), 0 24px 80px rgba(0,0,0,.32); backdrop-filter: blur(24px) saturate(200%); }
  .rounded-xl, .rounded-2xl, .rounded-lg, .rounded-md { border-radius: 2rem; }
  .rounded-full { border-radius: 9999px; }
  :is(article, .glass-surface, .bg-surface, .spotlight-card) { position: relative; isolation: isolate; overflow: hidden; border-color: rgba(255,255,255,.14); box-shadow: inset 0 1px 0 rgba(255,255,255,.16), 0 24px 80px rgba(0,0,0,.24); }
  :is(article, .glass-surface, .bg-surface, .spotlight-card)::after { position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: radial-gradient(320px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(212,212,212,.19), transparent 68%); content: ""; opacity: 0; pointer-events: none; transition: opacity .25s ease; }
  :is(article, .glass-surface, .bg-surface, .spotlight-card):hover::after { opacity: 1; }
  main :is(section, article, div)[class*="bg-[#"] { border-color: rgba(255,255,255,.13); background: linear-gradient(145deg, rgba(255,255,255,.075), rgba(18,18,18,.72) 58%, rgba(163,163,163,.045)) !important; box-shadow: inset 0 1px 0 rgba(255,255,255,.13), 0 22px 65px rgba(0,0,0,.2); backdrop-filter: blur(24px) saturate(180%); }
  button { border-radius: 1.25rem; box-shadow: inset 0 1px 0 rgba(255,255,255,.12); backdrop-filter: blur(18px) saturate(170%); transition: transform .2s ease, box-shadow .25s ease, border-color .25s ease; }
  :is(input, select, textarea) { border-radius: 1.25rem !important; border-color: rgba(255,255,255,.15) !important; background: linear-gradient(145deg, rgba(255,255,255,.075), rgba(0,0,0,.24)) !important; box-shadow: inset 0 1px 0 rgba(255,255,255,.1); backdrop-filter: blur(18px) saturate(170%); }
  .social-squircle { position: relative; display: inline-flex; height: 46px; width: 46px; align-items: center; justify-content: center; overflow: hidden; border: 1px solid rgba(255,255,255,.15); border-radius: 17px; background: linear-gradient(145deg, rgba(255,255,255,.17), rgba(255,255,255,.035)); box-shadow: inset 0 1px 0 rgba(255,255,255,.24), 0 8px 26px rgba(0,0,0,.3); backdrop-filter: blur(20px) saturate(180%); color: #e4e4e7; transition: transform .2s ease, box-shadow .25s ease, background .25s ease; }
  .social-squircle svg { height: 19px; width: 19px; fill: currentColor; }
  .social-squircle:hover { transform: translateY(-2px); color: white; }
  .social-squircle.is-active { border-color: rgba(250,250,250,.7); background: linear-gradient(145deg, #fafafa, #d4d4d4); box-shadow: inset 0 1px 0 rgba(255,255,255,.44), 0 0 28px rgba(250,250,250,.2); color: #0a0a0a; }
  .social-squircle.is-active::before { position: absolute; inset: -60% -30%; background: linear-gradient(110deg, transparent 38%, rgba(255,255,255,.75) 49%, transparent 60%); content: ""; transform: translateX(-100%); animation: shineSweep .8s ease-out; }
  .social-squircle.is-active svg { position: relative; z-index: 2; }
  @keyframes shineSweep { to { transform: translateX(100%); } }
  :is(a, button)[class*="bg-violet-400"], :is(a, button)[class*="bg-emerald-500"] { position: relative; isolation: isolate; overflow: hidden; border: 1px solid rgba(255,255,255,.28); box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 10px 32px rgba(163,163,163,.25); transition: transform .2s ease, box-shadow .25s ease, filter .25s ease; }
  :is(a, button)[class*="bg-violet-400"]::before, :is(a, button)[class*="bg-emerald-500"]::before { position: absolute; inset: -100% -30%; z-index: -1; background: linear-gradient(110deg, transparent 44%, rgba(255,255,255,.42) 50%, transparent 56%); content: ""; transform: translateX(-55%); transition: transform .7s ease; }
  :is(a, button)[class*="bg-violet-400"]:hover::before, :is(a, button)[class*="bg-emerald-500"]:hover::before { transform: translateX(55%); }
  :is(a, button)[class*="bg-violet-400"]:hover, :is(a, button)[class*="bg-emerald-500"]:hover { box-shadow: inset 0 1px 0 rgba(255,255,255,.38), 0 14px 42px rgba(163,163,163,.36); filter: saturate(1.15); }
  :is(a, button)[class*="bg-violet-400"]:active, :is(a, button)[class*="bg-emerald-500"]:active, button:active { transform: scale(.96); }
  .stack-slide { border-radius: 2rem; }
  .eyebrow { font-family: var(--font-mono), monospace; font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: #d4d4d4; }
  .display-outline { color: transparent; -webkit-text-stroke: 1.5px rgba(212,212,212,.92); }
  .dot-field { background-image: radial-gradient(rgba(212,212,212,.23) .8px, transparent .8px); background-size: 24px 24px; }
  ::view-transition-old(root) { animation: page-out .24s cubic-bezier(.7,0,.84,0) both; }
  ::view-transition-new(root) { animation: page-in .48s cubic-bezier(.2,.8,.2,1) both; }
  /* Opacity and movement only: a colour filter does nothing to a black-and-white page but makes the
     browser filter a full-page snapshot on every frame of the transition. */
  @keyframes page-in { from { opacity: 0; transform: translateX(26px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes page-out { to { opacity: 0; transform: translateX(-18px); } }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto !important; }
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
  }
  /* Phones and tablets: frosted glass re-blurs the moving background behind every card on every
     frame, one of the largest costs on a mid-range phone. Solid dark surfaces with the same base look the
     same at this size and cost nothing. Desktops keep the glass. */
  @media (hover: none), (max-width: 767px) {
    *, *::before, *::after { -webkit-backdrop-filter: none !important; backdrop-filter: none !important; }
    /* Each surface keeps its own gradient; the opaque base is the page colour the blur used to show. */
    .glass-surface, .bg-surface, .footer-panel { background-color: #0b0b0b; }
    main :is(section, article, div)[class*="bg-[#"] { background: linear-gradient(145deg, rgba(255,255,255,.075), rgba(18,18,18,.72) 58%, rgba(163,163,163,.045)), #0a0a0a !important; }
    .smart-navbar nav { background-color: rgba(18,18,18,.96); }
  }
  .prose-technical h2 { margin-top: 3rem; scroll-margin-top: 6rem; font-size: 1.7rem; font-weight: 650; letter-spacing: -.025em; color: #fafafa; }
  .prose-technical h3 { margin-top: 2rem; font-size: 1.2rem; font-weight: 600; color: #e4e4e7; }
  .prose-technical p, .prose-technical li { color: #a1a1aa; line-height: 1.8; }
  .prose-technical p { margin-top: 1rem; }
  .prose-technical ul, .prose-technical ol { margin: 1rem 0; padding-left: 1.4rem; }
  .prose-technical li { margin: .45rem 0; }
  .prose-technical li::marker { color: #d4d4d4; }
  .prose-technical a { color: #d4d4d4; text-decoration: underline; text-underline-offset: 3px; }
  .prose-technical :not(pre) > code { border: 1px solid rgba(255,255,255,.12); border-radius: .75rem; background: linear-gradient(145deg, rgba(255,255,255,.09), rgba(255,255,255,.035)); padding: .12rem .4rem; font-family: var(--font-mono), monospace; font-size: .88em; color: #e4e4e7; }
  .prose-technical pre { overflow-x: auto; margin: 1.25rem 0; border: 1px solid rgba(255,255,255,.12); border-radius: 1.5rem; background: linear-gradient(145deg, rgba(255,255,255,.07), rgba(10,10,10,.82)); padding: 1.25rem; font-family: var(--font-mono), monospace; font-size: .82rem; line-height: 1.75; color: #d4d4d8; box-shadow: inset 0 1px 0 rgba(255,255,255,.12), 0 18px 50px rgba(0,0,0,.2); }
  .prose-technical pre code { font: inherit; }
  .prose-technical table { width: 100%; margin: 1.5rem 0; border: 1px solid rgba(255,255,255,.12); border-collapse: separate; border-spacing: 0; border-radius: 1.25rem; overflow: hidden; background: linear-gradient(145deg, rgba(255,255,255,.06), rgba(255,255,255,.015)); font-size: .92rem; }
  .prose-technical th, .prose-technical td { border: 1px solid #27272a; padding: .75rem; text-align: left; vertical-align: top; }
  .prose-technical th { background: #18181b; color: #e4e4e7; }
  .prose-technical td { color: #a1a1aa; }
</style>
