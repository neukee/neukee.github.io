---
import BaseLayout from '../../layouts/BaseLayout.astro';

const description = 'Field notes from Neukee on safer runtime upgrades, CI trust boundaries, dependency bots, and engineering decisions that deserve evidence.';
const posts = [
  {
    href: '/blog/runtime-drift-is-a-deployment-problem/',
    category: 'RUNTIME / OPERATIONS',
    date: 'NOV 23, 2026',
    title: 'Runtime drift is a deployment problem, not a version-file problem',
    excerpt: 'Why a green local test can still ship a different Node binary—and how to map every version selector before the migration branch opens.',
  },
  {
    href: '/blog/lockfiles-are-evidence-not-guarantees/',
    category: 'DEPENDENCIES / SUPPLY CHAIN',
    date: 'NOV 23, 2026',
    title: 'A lockfile is evidence of resolution, not a compatibility guarantee',
    excerpt: 'Use the resolved graph to find native modules and peer constraints, then test the exact operating system and runtime you deploy.',
  },
  {
    href: '/blog/behavioral-diffs-for-automated-prs/',
    category: 'CI / REVIEW',
    date: 'NOV 23, 2026',
    title: 'Automated pull requests need behavioral evidence',
    excerpt: 'Mocks and green checks matter, but neither shows you every production boundary a dependency change can affect.',
  },
];
---

<BaseLayout title="Field Notes | Neukee" {description} canonicalPath="/blog/">
  <section class="relative isolate overflow-hidden border-b border-white/10 px-5 py-20 sm:py-28" data-reveal>
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_82%_20%,rgba(163,163,163,.18),transparent_42%),linear-gradient(135deg,#0a0a0a,#101010)]"></div>
    <div class="mx-auto max-w-7xl">
      <p class="eyebrow">Field notes / Written from the upgrade queue</p>
      <h1 class="mt-5 max-w-5xl text-5xl font-semibold leading-[.96] tracking-[-.055em] sm:text-7xl">The parts between the release note and production.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-400">Practical ideas for runtime migrations, dependency review, and CI trust boundaries. No magic score; just context you can take back to your team.</p>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-5 py-14 lg:px-8 lg:py-20">
    <div class="grid gap-4 lg:grid-cols-3">
      {posts.map((post, index) => (
        <a href={post.href} class="glass-surface group flex min-h-72 flex-col rounded-xl p-6 transition duration-300 hover:-translate-y-1 hover:border-violet-300/30 sm:p-7" data-reveal>
          <div class="flex items-center justify-between gap-3"><span class="font-mono text-[9px] tracking-[.12em] text-violet-300">{post.category}</span><span class="font-mono text-[9px] text-zinc-600">{post.date}</span></div>
          <span class="mt-9 font-mono text-xs text-zinc-600">0{index + 1} / FIELD NOTE</span>
          <h2 class="mt-3 text-2xl font-semibold leading-tight tracking-tight text-zinc-100 group-hover:text-violet-100">{post.title}</h2>
          <p class="mt-4 text-sm leading-6 text-zinc-400">{post.excerpt}</p>
          <span class="mt-auto pt-7 text-sm text-violet-300">Read the note <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>
  <section class="border-y border-white/10 bg-[#0d0d0d]" data-reveal>
    <div class="mx-auto max-w-7xl px-5 py-14 lg:px-8 lg:py-20">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><p class="eyebrow">Deep technical guides</p><h2 class="mt-3 text-3xl font-semibold">Take the full checklist into your change review.</h2></div><a class="text-sm text-violet-300 hover:text-violet-200" href="/guides/">Browse all upgrade guides ↗</a></div>
      <div class="mt-8 grid gap-3 md:grid-cols-2">
        <a class="rounded-lg border border-white/10 bg-black/20 p-5 text-zinc-300 transition hover:border-violet-300/30 hover:text-white" href="/guides/node-22-eol-migration-checklist/">Node.js 22 end-of-life checklist <span class="float-right text-violet-300">↗</span></a>
        <a class="rounded-lg border border-white/10 bg-black/20 p-5 text-zinc-300 transition hover:border-violet-300/30 hover:text-white" href="/guides/node-22-to-26-breaking-changes/">Node.js 22 to 26: every breaking change <span class="float-right text-violet-300">↗</span></a>
        <a class="rounded-lg border border-white/10 bg-black/20 p-5 text-zinc-300 transition hover:border-violet-300/30 hover:text-white" href="/guides/nextjs-15-to-16-upgrade-guide/">Next.js 15 to 16 upgrade guide <span class="float-right text-violet-300">↗</span></a>
        <a class="rounded-lg border border-white/10 bg-black/20 p-5 text-zinc-300 transition hover:border-violet-300/30 hover:text-white" href="/guides/verify-ai-agent-prs-in-ci/">Verify AI-agent PRs in CI <span class="float-right text-violet-300">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
