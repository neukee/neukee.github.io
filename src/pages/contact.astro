---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'Contact Neukee directly about a Node.js or Next.js migration, a fleet readiness review, product feedback, or a responsible security disclosure.';
---

<BaseLayout title="Contact Neukee | Talk through the upgrade" {description} canonicalPath="/contact/">
  <section class="relative isolate overflow-hidden border-b border-white/10 px-5 py-20 sm:py-28" data-reveal>
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_78%_22%,rgba(124,58,237,.2),transparent_42%),linear-gradient(135deg,#08070b,#100c16)]"></div>
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1fr_.8fr] lg:items-end">
      <div><p class="eyebrow">Direct line · No sales queue</p><h1 class="mt-5 max-w-4xl text-5xl font-semibold leading-[.96] tracking-[-.05em] sm:text-7xl">Start with the problem you’re trying to ship.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-400">Tell us the runtime or framework move, what’s running in CI, and where you’re uncertain. Please keep private source, credentials, and customer data out of email.</p></div>
      <div class="glass-surface rounded-2xl p-6 sm:p-8" data-reveal><p class="font-mono text-[10px] uppercase tracking-[.18em] text-zinc-500">Email, directly</p><a class="mt-3 block break-all text-2xl font-semibold tracking-tight text-violet-200 hover:text-violet-100 sm:text-3xl" href="mailto:venuuu.nyc@proton.me">venuuu.nyc@proton.me</a><p class="mt-4 text-sm leading-6 text-zinc-500">Opens your configured email application. Your message is only sent when you press Send.</p><a class="mt-6 inline-flex items-center gap-2 rounded-md bg-violet-400 px-5 py-3 text-sm font-semibold text-zinc-950 hover:bg-violet-300" href="mailto:venuuu.nyc@proton.me?subject=Neukee%20%E2%80%94%20let%E2%80%99s%20talk">Compose a message ↗</a></div>
    </div>
  </section>
  <section class="mx-auto grid max-w-7xl gap-4 px-5 py-14 sm:grid-cols-3 lg:px-8 lg:py-20">
    <article class="glass-surface rounded-xl p-6" data-reveal><p class="eyebrow">Migration</p><h2 class="mt-4 text-xl font-semibold">Node.js or Next.js upgrade</h2><p class="mt-3 text-sm leading-7 text-zinc-400">Share the source and target versions, deployment environment, and the failure you want to avoid.</p></article>
    <article class="glass-surface rounded-xl p-6" data-reveal><p class="eyebrow">Fleet audit</p><h2 class="mt-4 text-xl font-semibold">Plan across repositories</h2><p class="mt-3 text-sm leading-7 text-zinc-400">Use the static audit form for a structured email draft and pre-call checklist.</p><a class="mt-4 inline-block text-sm text-violet-300 hover:text-violet-200" href="/#fleet-audit">Go to the fleet audit →</a></article>
    <article class="glass-surface rounded-xl p-6" data-reveal><p class="eyebrow">Security</p><h2 class="mt-4 text-xl font-semibold">Report a vulnerability</h2><p class="mt-3 text-sm leading-7 text-zinc-400">Send a concise summary and a safe reproduction outline. Do not send secrets or exploit payloads that affect third-party systems.</p><a class="mt-4 inline-block text-sm text-violet-300 hover:text-violet-200" href="mailto:venuuu.nyc@proton.me?subject=Security%20report">Start a private report →</a></article>
  </section>
  <section class="border-y border-white/10 bg-[#0d0b12]" data-reveal>
    <div class="mx-auto max-w-5xl px-5 py-14 lg:px-8 lg:py-20">
      <div class="text-center"><p class="eyebrow">A useful first message</p><h2 class="mt-3 text-3xl font-semibold">Pick the context. We’ll make the reply useful.</h2><p class="mx-auto mt-4 max-w-xl text-sm leading-6 text-zinc-500">Choose what best describes the work; the email draft will include a short prompt, not a hidden submission.</p></div>
      <div class="mt-8 flex flex-wrap justify-center gap-2" role="tablist" aria-label="Contact topic">
        <button class="rounded-full border border-violet-300/40 bg-violet-300/10 px-4 py-2 text-sm text-violet-100" type="button" role="tab" id="contact-tab-upgrade" aria-selected="true" aria-controls="contact-panel-upgrade" data-contact-tab="upgrade">New upgrade</button>
        <button class="rounded-full border border-white/10 px-4 py-2 text-sm text-zinc-400 hover:text-white" type="button" role="tab" id="contact-tab-takeover" aria-selected="false" aria-controls="contact-panel-takeover" data-contact-tab="takeover" tabindex="-1">Existing migration</button>
        <button class="rounded-full border border-white/10 px-4 py-2 text-sm text-zinc-400 hover:text-white" type="button" role="tab" id="contact-tab-ci" aria-selected="false" aria-controls="contact-panel-ci" data-contact-tab="ci" tabindex="-1">CI / security</button>
      </div>
      <div class="mx-auto mt-5 max-w-2xl">
        <div class="glass-surface rounded-xl p-6 text-center sm:p-8" role="tabpanel" id="contact-panel-upgrade" aria-labelledby="contact-tab-upgrade" data-contact-panel="upgrade">
          <h3 class="text-xl font-semibold">Planning a version move?</h3><p class="mt-3 text-sm leading-6 text-zinc-400">Include the source and target versions, deployment platform, and the decision your team needs to make next.</p>
        </div>
        <div class="glass-surface hidden rounded-xl p-6 text-center sm:p-8" role="tabpanel" id="contact-panel-takeover" aria-labelledby="contact-tab-takeover" data-contact-panel="takeover" hidden>
          <h3 class="text-xl font-semibold">Already partway through?</h3><p class="mt-3 text-sm leading-6 text-zinc-400">Describe the repository shape, current blocker, test environment, and any deadline that changes the risk trade-off.</p>
        </div>
        <div class="glass-surface hidden rounded-xl p-6 text-center sm:p-8" role="tabpanel" id="contact-panel-ci" aria-labelledby="contact-tab-ci" data-contact-panel="ci" hidden>
          <h3 class="text-xl font-semibold">Reviewing trust or CI controls?</h3><p class="mt-3 text-sm leading-6 text-zinc-400">Share the workflow boundary, what data is in scope, and which control you need to validate. Keep credentials and source out of the email.</p>
        </div>
        <a class="mt-4 flex items-center justify-center gap-2 rounded-md bg-violet-400 px-5 py-3 text-sm font-semibold text-zinc-950 hover:bg-violet-300" href="mailto:venuuu.nyc@proton.me?subject=Neukee%20%E2%80%94%20new%20upgrade" data-contact-link>Continue by email <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initializeContactTabs() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-contact-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-contact-panel]'));
    const emailLink = document.querySelector<HTMLAnchorElement>('[data-contact-link]');
    if (!tabs.length || tabs[0]?.dataset.bound === 'true') return;
    tabs.forEach((tab) => { tab.dataset.bound = 'true'; });
    const subjects: Record<string, string> = {
      upgrade: 'Neukee%20%E2%80%94%20new%20upgrade',
      takeover: 'Neukee%20%E2%80%94%20existing%20migration',
      ci: 'Neukee%20%E2%80%94%20CI%20and%20security',
    };
    function selectTab(selected: HTMLButtonElement) {
      const activeId = selected.dataset.contactTab;
      tabs.forEach((tab) => {
        const active = tab === selected;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        tab.classList.toggle('border-violet-300/40', active);
        tab.classList.toggle('bg-violet-300/10', active);
        tab.classList.toggle('text-violet-100', active);
        tab.classList.toggle('border-white/10', !active);
        tab.classList.toggle('text-zinc-400', !active);
      });
      panels.forEach((panel) => {
        const active = panel.dataset.contactPanel === activeId;
        panel.hidden = !active;
        panel.classList.toggle('hidden', !active);
      });
      if (emailLink && activeId && subjects[activeId]) emailLink.href = `mailto:venuuu.nyc@proton.me?subject=${subjects[activeId]}`;
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1
          : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        tabs[next]?.focus();
        if (tabs[next]) selectTab(tabs[next]);
      });
    });
  }
  initializeContactTabs();
  document.addEventListener('astro:page-load', initializeContactTabs);
</script>
