---
import BaseLayout from '../../layouts/BaseLayout.astro';

const description = 'Practical, evidence-based migration guides for Node.js runtime upgrades, Next.js breaking changes, and reviewing dependency or AI-agent pull requests.';
const guides = [
  {
    href: '/guides/node-22-eol-migration-checklist/',
    label: 'NODE.JS LIFECYCLE',
    title: 'Node.js 22 end of life: migration checklist',
    text: 'Node.js 22 reaches end of life on April 30, 2027. Official support dates, how to choose between 26 and 24, a seven-point audit and a staged rollout.',
  },
  {
    href: '/guides/node-22-to-26-breaking-changes/',
    label: 'RUNTIME COMPATIBILITY',
    title: 'Node.js 22 to 26: every breaking change',
    text: 'Removed APIs, new deprecation warnings, TLS security level 2, native module ABI 147, require(esm) and Corepack, each with a search to find it in your code. Checked against the official changelogs.',
  },
  {
    href: '/guides/nextjs-15-to-16-upgrade-guide/',
    label: 'FRAMEWORK MIGRATION',
    title: 'Next.js 16 upgrade guide: every breaking change',
    text: 'Node.js 20.9, Turbopack by default, async-only request APIs, middleware to proxy, next/image defaults and removed config, each with a search to find it in your code. Checked against the official guide.',
  },
  {
    href: '/guides/verify-ai-agent-prs-in-ci/',
    label: 'CI & REVIEW',
    title: 'How to verify AI agent and Dependabot pull requests in CI',
    text: 'Pair unit tests with repeatable baseline-versus-candidate evidence, and run untrusted pull request code safely in GitHub Actions.',
  },
];
---

<BaseLayout title="Node.js & Next.js Upgrade Guides | Neukee" {description} canonicalPath="/guides/">
  <section class="border-b border-zinc-800 bg-[#0c0c0e]">
    <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
      <p class="font-mono text-xs uppercase tracking-[.2em] text-emerald-300">Field notes for software teams</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight sm:text-5xl">Guides for the upgrades hiding in your dependency graph.</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-zinc-400">Technical migration notes for teams that want to know what they need to test before a new runtime or framework version is in production. Each guide pairs migration choices with concrete code and review steps.</p>
    </div>
  </section>
  <section class="mx-auto grid max-w-7xl gap-4 px-5 py-14 md:grid-cols-2 lg:px-8 lg:py-20">
    {guides.map((guide, index) => (
      <a href={guide.href} class="group rounded-xl border border-zinc-800 bg-surface p-7 transition hover:border-emerald-500/40">
        <p class="font-mono text-[11px] tracking-[.16em] text-emerald-300">{guide.label} <span class="ml-2 text-zinc-600">/ 0{index + 1}</span></p>
        <h2 class="mt-5 text-2xl font-semibold tracking-tight group-hover:text-emerald-100">{guide.title}</h2>
        <p class="mt-3 leading-7 text-zinc-400">{guide.text}</p>
        <span class="mt-7 inline-flex items-center gap-2 text-sm text-zinc-300">Read the guide <span class="transition group-hover:translate-x-1">→</span></span>
      </a>
    ))}
  </section>
  <div class="mx-auto max-w-7xl px-5 pb-20 lg:px-8">
    <div class="rounded-xl border border-zinc-800 bg-[#0c0c0e] p-6 text-sm leading-6 text-zinc-500">
      <strong class="text-zinc-300">Check the upstream schedule before you set dates.</strong>
      Runtime and framework support policies change. These articles explain engineering practices; always confirm version status and migration requirements against the linked official release notes before making production decisions.
    </div>
  </div>
</BaseLayout>
