---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'Terms for accessing the Neukee website and project information, including content, open-source software, email inquiries, and site limitations.';
---

<BaseLayout title="Terms of Use | Neukee" {description} canonicalPath="/terms/">
  <section class="border-b border-white/10 bg-[#0d0b12] px-5 py-16 sm:py-20" data-reveal>
    <div class="mx-auto max-w-7xl"><p class="eyebrow">Plain-language terms</p><h1 class="mt-4 text-5xl font-semibold tracking-tight sm:text-6xl">Terms of use</h1><p class="mt-5 max-w-2xl text-sm text-zinc-500">Last updated: November 23, 2026 · Read alongside the <a class="text-violet-300 hover:text-violet-200" href="/privacy/">Privacy notice</a>.</p></div>
  </section>
  <article class="prose-technical mx-auto max-w-4xl px-5 py-10 lg:px-8 lg:py-16" data-reveal>
    <p>These terms describe your use of the public Neukee website at <code>neukee.github.io</code> (the “Site”) and the information presented here. By using the Site, you agree to these terms. If you do not agree, do not use the Site.</p>
    <h2 id="operator">1. Who publishes this Site</h2>
    <p>The Site is published under the Neukee project name. This Site does not identify a registered legal entity or business address. Do not treat this page as a service contract. Any paid audit, consulting, or other engagement requires a separate written agreement that identifies the contracting parties, scope, fees, deliverables, and applicable terms.</p>
