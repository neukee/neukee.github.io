---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpgradeAuditSection from '../components/UpgradeAuditSection.astro';
import ScrollMarquee from '../components/ScrollMarquee.astro';
import SocialDock from '../components/SocialDock.astro';
import BrandMark from '../components/BrandMark.astro';

const description = 'Neukee is an open-source, local-first scanner that finds what breaks before you upgrade Node.js or Next.js, with every finding linked to the official release note. Version 0.1.0 is planned for December 8, 2026.';
---

<BaseLayout title="Neukee: know what breaks before you upgrade Node.js or Next.js" description={description} canonicalPath="/">
  <div class="stack-stage">
  <section class="neukee-hero stack-slide relative isolate overflow-hidden border-b border-white/10 px-5 py-20 sm:py-28 lg:py-32" data-stack-slide style="--stack-order: 1">
    <div class="hero-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-[1.03fr_.97fr] lg:gap-10">
      <div data-reveal>
        <p class="eyebrow flex items-center gap-3"><span class="h-px w-8 bg-violet-300"></span> Engineering tools for modern software teams</p>
        <p class="mt-5 font-mono text-[10px] tracking-[.16em] text-zinc-500 sm:text-xs">NEXT.JS 16 · NODE.JS 24 · OPEN SOURCE · LOCAL-FIRST</p>
        <h1 class="mt-7 max-w-3xl text-5xl font-semibold leading-[.92] tracking-[-.065em] text-zinc-50 sm:text-7xl lg:text-[4.4rem]">
          Know what breaks<br />
          <span class="display-outline font-medium">before</span> you<br />
          upgrade.
        </h1>
        <p class="mt-7 max-w-xl text-base leading-7 text-zinc-400 sm:text-lg sm:leading-8">
          Neukee is an open-source scanner for Node.js and Next.js upgrades. It reads your code, lockfiles and runtime config on your machine, and points at the exact lines that will break, each linked to the official release note.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a class="inline-flex items-center gap-3 rounded-md bg-violet-400 px-5 py-3 text-sm font-semibold text-zinc-950 transition hover:bg-violet-300" href="#checks">See what it checks <span aria-hidden="true">↓</span></a>
          <a class="rounded-md border border-white/15 px-5 py-3 text-sm font-medium text-zinc-200 transition hover:border-violet-300/50 hover:bg-white/[.04]" href="mailto:venuuu.nyc@proton.me">Talk to the engineer <span aria-hidden="true">↗</span></a>
        </div>
        <a class="mt-8 inline-flex max-w-full items-center gap-3 rounded-md border border-white/10 bg-white/[.04] px-4 py-2.5 font-mono text-xs text-zinc-300 backdrop-blur-md transition hover:border-white/25" href="https://github.com/neukee/neukee" target="_blank" rel="noreferrer">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-300" aria-hidden="true"></span>
          <span>Pre-release · v0.1.0 planned for Dec 8, 2026 · follow on GitHub</span>
        </a>
        <div class="mt-5 flex items-center gap-3">
          <span class="font-mono text-[10px] uppercase tracking-[.15em] text-zinc-500">Find Neukee</span>
          <SocialDock />
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-xl" data-reveal>
        <div class="absolute -inset-8 rounded-full bg-violet-600/20 blur-[80px]" aria-hidden="true"></div>
        <div class="glass-surface hero-float relative rounded-2xl p-4 sm:p-6">
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <div class="flex items-center gap-3"><BrandMark class="h-8 w-auto text-zinc-100" /><div><p class="text-sm font-medium text-zinc-100">What version 0.1.0 flags</p><p class="font-mono text-[10px] text-zinc-500">illustration of two finding types</p></div></div>
            <span class="rounded-full border border-violet-300/20 bg-violet-300/10 px-2.5 py-1 font-mono text-[9px] text-violet-200">EXAMPLE</span>
          </div>
          <div class="mt-5 flex items-center justify-between rounded-lg border border-white/[.07] bg-black/30 p-3 font-mono text-[10px]">
            <span class="text-zinc-500">TARGET</span><span class="text-zinc-200">node@24 · next@16</span><span class="text-zinc-500">local scan</span>
          </div>
          <div class="mt-4 space-y-3">
            <div class="rounded-lg border border-red-400/15 bg-red-400/[.04] p-3.5">
              <div class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-red-400"></span><span class="font-mono text-[10px] text-red-300">Runtime drift</span><span class="ml-auto font-mono text-[9px] text-zinc-600">ACTION REQUIRED</span></div>
              <p class="mt-2 text-xs text-zinc-300"><code>.nvmrc</code> → Node 24 <span class="text-zinc-600">/</span> Docker → Node 20</p>
            </div>
            <div class="rounded-lg border border-amber-300/15 bg-amber-300/[.035] p-3.5">
              <div class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-amber-300"></span><span class="font-mono text-[10px] text-amber-200">Next.js 16</span><span class="ml-auto font-mono text-[9px] text-zinc-600">ACTION REQUIRED</span></div>
              <p class="mt-2 text-xs text-zinc-300"><code>cookies()</code> called without <code>await</code></p>
            </div>
          </div>
          <div class="mt-4 flex items-center justify-between border-t border-white/10 pt-4 font-mono text-[9px] uppercase tracking-[.12em] text-zinc-600">
            <span>NO NETWORK</span><span>NEVER RUNS YOUR CODE</span><span>SARIF OUTPUT</span>
          </div>
        </div>
        <div class="absolute -bottom-5 -left-4 rounded-lg border border-white/10 bg-[#141414]/90 px-4 py-3 font-mono text-[10px] text-zinc-300 shadow-xl backdrop-blur-xl sm:-left-10">
          <span class="text-violet-300">↳</span> release note cited <span class="ml-2 text-emerald-300">✓</span>
        </div>
      </div>
    </div>
  </section>
  </div>

  <section class="border-b border-white/10 bg-white/[.025] py-4" aria-label="Neukee engineering focus">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-8 gap-y-2 px-5 font-mono text-[10px] tracking-[.18em] text-zinc-500 sm:text-xs lg:justify-between lg:px-8">
      <span class="text-violet-200">RUNTIME DRIFT</span><span>LOCKFILES</span><span>NATIVE ADDONS</span><span>NEXT.JS 16</span><span>SARIF</span>
    </div>
  </section>

  <ScrollMarquee />

  <div class="stack-stage">
  <section id="checks" class="stack-slide mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24" data-stack-slide style="--stack-order: 2">
    <div class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-xs uppercase tracking-[.2em] text-emerald-300">Version 0.1.0 · planned for December 8, 2026</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-zinc-50 sm:text-4xl">What the first release checks.</h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-zinc-500">Every finding carries a severity, a file, line and column, a suggested fix and a link to the official release note. Progress is tracked in the open on GitHub.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <article class="glass-surface rounded-xl p-6" data-reveal>
        <span class="font-mono text-xs text-violet-300">01 / RUNTIME DRIFT</span>
        <h3 class="mt-5 text-xl font-semibold">Every place a Node.js version hides</h3>
        <p class="mt-3 text-sm leading-7 text-zinc-400">Reads <code class="font-mono text-xs text-zinc-300">.nvmrc</code>, <code class="font-mono text-xs text-zinc-300">.node-version</code>, <code class="font-mono text-xs text-zinc-300">engines</code>, Volta, Dockerfiles and GitHub Actions. Flags versions below your target, sources that disagree, and versions past end of life.</p>
      </article>
      <article class="glass-surface rounded-xl p-6" data-reveal>
        <span class="font-mono text-xs text-violet-300">02 / NATIVE ADDONS</span>
        <h3 class="mt-5 text-xl font-semibold">Dependencies that compile at install</h3>
        <p class="mt-3 text-sm leading-7 text-zinc-400">Finds packages that build native code during install, read from the install-script flags in <code class="font-mono text-xs text-zinc-300">package-lock.json</code> and <code class="font-mono text-xs text-zinc-300">pnpm-lock.yaml</code>, without running a package manager.</p>
      </article>
      <article class="glass-surface rounded-xl p-6" data-reveal>
        <span class="font-mono text-xs text-violet-300">03 / NEXT.JS 16</span>
        <h3 class="mt-5 text-xl font-semibold">Framework changes, line by line</h3>
        <p class="mt-3 text-sm leading-7 text-zinc-400"><code class="font-mono text-xs text-zinc-300">cookies()</code>, <code class="font-mono text-xs text-zinc-300">headers()</code> and <code class="font-mono text-xs text-zinc-300">draftMode()</code> without <code class="font-mono text-xs text-zinc-300">await</code>, synchronous <code class="font-mono text-xs text-zinc-300">params</code>, middleware that must become proxy, custom webpack config, removed config keys and <code class="font-mono text-xs text-zinc-300">next lint</code> scripts.</p>
      </article>
    </div>
    <p class="mt-6 font-mono text-xs text-zinc-500">Output: terminal · Markdown for pull requests · JSON with a versioned schema · SARIF for GitHub code scanning</p>
  </section>
  </div>

  <div class="stack-stage">
  <section id="how-it-works" class="stack-slide mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28" data-stack-slide style="--stack-order: 3">
    <div class="max-w-3xl">
      <p class="eyebrow">01 / Capabilities</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-zinc-50 sm:text-4xl">Upgrades rarely fail on the change you read about.</h2>
      <p class="mt-5 text-lg leading-8 text-zinc-400">The hard failures hide between the release notes and the way your application is actually installed, deployed, and exercised. Neukee connects those clues before the migration branch becomes a production incident.</p>
    </div>
    <div class="mt-11 grid gap-4 md:grid-cols-3">
      <article class="glass-surface rounded-xl p-6 transition duration-300 hover:-translate-y-1 hover:border-violet-300/30" data-reveal>
        <span class="font-mono text-xs text-violet-300">01 / ENVIRONMENT</span>
        <h3 class="mt-5 text-xl font-semibold">Runtime &amp; deploy drift</h3>
        <p class="mt-3 text-sm leading-7 text-zinc-400">One application can quietly declare several Node versions. Neukee compares <code class="font-mono text-xs text-zinc-300">.nvmrc</code>, <code class="font-mono text-xs text-zinc-300">package.json#engines</code>, Docker base images and CI workflows for mismatches that make “works on my machine” inevitable.</p>
        <p class="mt-4 text-sm leading-7 text-zinc-500">The result is a map of which runtime each build path really selects, including the container image a package manifest can’t tell you about. Deployment platform config follows after launch.</p>
      </article>
      <article class="glass-surface rounded-xl p-6 transition duration-300 hover:-translate-y-1 hover:border-violet-300/30" data-reveal>
        <span class="font-mono text-xs text-violet-300">02 / DEPENDENCIES</span>
        <h3 class="mt-5 text-xl font-semibold">What you really install</h3>
        <p class="mt-3 text-sm leading-7 text-zinc-400">Manifests describe intent; lockfiles describe the resolved graph. Neukee inspects npm and pnpm lockfiles to flag dependencies that build native code at install time, without running <code class="font-mono text-xs text-zinc-300">npm install</code> or any package script.</p>
        <p class="mt-4 text-sm leading-7 text-zinc-500">That keeps the scan useful in restricted environments and focuses review on the transitive packages that can fail only after a runtime or framework boundary moves.</p>
      </article>
      <article class="glass-surface rounded-xl p-6 transition duration-300 hover:-translate-y-1 hover:border-violet-300/30" data-reveal>
        <span class="font-mono text-xs text-violet-300">03 / BEHAVIOR · PLANNED</span>
        <h3 class="mt-5 text-xl font-semibold">Behavioral verification, next</h3>
        <p class="mt-3 text-sm leading-7 text-zinc-400">Not part of version 0.1.0. The engine we’re building with design partners runs your own tests on the old and new versions inside your CI and shows every difference in behavior, so dependency and AI-agent pull requests merge with evidence.</p>
        <p class="mt-4 text-sm leading-7 text-zinc-500">Your team reviews each difference and decides whether it’s expected. Neukee never rewrites tests or code.</p>
      </article>
    </div>
  </section>
  </div>

  <section id="process" class="border-y border-white/10 bg-[#0d0d0d]" data-reveal>
    <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div><p class="eyebrow">02 / How the work moves</p><h2 class="mt-4 max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">Make the risky part visible. Then make a decision.</h2></div>
        <p class="max-w-lg leading-7 text-zinc-400">A useful upgrade review is a short chain of evidence—not a mysterious green check. Every step should leave your team with an artifact it can inspect and rerun.</p>
      </div>
      <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
        <article class="bg-[#0d0d0d] p-6 sm:p-7" data-reveal><p class="font-mono text-xs text-violet-300">01 / SCOPE</p><h3 class="mt-5 text-lg font-semibold">Name the move.</h3><p class="mt-3 text-sm leading-6 text-zinc-500">Choose source and target versions, repositories, deployment paths, and an owner for each service.</p></article>
        <article class="bg-[#0d0d0d] p-6 sm:p-7" data-reveal><p class="font-mono text-xs text-violet-300">02 / INSPECT</p><h3 class="mt-5 text-lg font-semibold">Map the reality.</h3><p class="mt-3 text-sm leading-6 text-zinc-500">Compare runtime declarations, resolved lockfiles, source patterns, and the configs that ship the app.</p></article>
        <article class="bg-[#0d0d0d] p-6 sm:p-7" data-reveal><p class="font-mono text-xs text-violet-300">03 / FIX</p><h3 class="mt-5 text-lg font-semibold">Follow the official path.</h3><p class="mt-3 text-sm leading-6 text-zinc-500">Each finding links the official release note or migration guide it comes from. Neukee never changes your code.</p></article>
        <article class="bg-[#0d0d0d] p-6 sm:p-7" data-reveal><p class="font-mono text-xs text-violet-300">04 / DECIDE</p><h3 class="mt-5 text-lg font-semibold">Ship with context.</h3><p class="mt-3 text-sm leading-6 text-zinc-500">Review source-linked findings, note the unknowns, and keep the rollback decision with the release.</p></article>
      </div>
    </div>
  </section>

  <div class="stack-stage">
  <section class="stack-slide border-y border-zinc-800 bg-[#0c0c0e]" data-stack-slide style="--stack-order: 4">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 lg:grid-cols-[.8fr_1.2fr] lg:items-center lg:px-8 lg:py-24">
      <div>
        <p class="eyebrow">03 / Trust boundaries first</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight">Built to be the safest binary in your CI.</h2>
        <p class="mt-4 leading-7 text-zinc-400">Upgrade tooling often receives untrusted pull request code. Neukee’s design goal is to learn from repository metadata without executing the repository.</p>
        <a class="mt-7 inline-flex items-center gap-2 text-sm font-medium text-violet-300 hover:text-violet-200" href="/security/">Read the security architecture <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="rounded-lg border border-zinc-800 bg-surface p-5"><h3 class="font-semibold">No-egress by design</h3><p class="mt-2 text-sm leading-6 text-zinc-500">Static checks can run without reaching package registries, analytics services, or external APIs.</p></div>
        <div class="rounded-lg border border-zinc-800 bg-surface p-5"><h3 class="font-semibold">No project execution</h3><p class="mt-2 text-sm leading-6 text-zinc-500">Parsing metadata is different from installing packages or invoking repository scripts.</p></div>
        <div class="rounded-lg border border-zinc-800 bg-surface p-5"><h3 class="font-semibold">Bounded input handling</h3><p class="mt-2 text-sm leading-6 text-zinc-500">Size limits, symlink refusal, and bounded matching constrain hostile repository inputs.</p></div>
        <div class="rounded-lg border border-zinc-800 bg-surface p-5"><h3 class="font-semibold">Evidence in the review</h3><p class="mt-2 text-sm leading-6 text-zinc-500">Findings are explainable and exportable so humans can decide what blocks a release.</p></div>
      </div>
    </div>
  </section>
  </div>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-24" data-reveal>
    <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl"><p class="eyebrow">04 / A deliberate roadmap</p><h2 class="mt-4 text-3xl font-semibold tracking-tight">Small, inspectable steps toward safer upgrades.</h2><p class="mt-4 leading-7 text-zinc-400">The roadmap is a direction, not a promise that every capability is already available. Validate current features in the project repository before adopting them.</p></div>
      <div class="font-mono text-xs text-zinc-600">OPEN DEVELOPMENT · BUILT IN PUBLIC</div>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      <div class="glass-surface rounded-xl p-6" data-reveal><p class="font-mono text-xs text-violet-300">PLANNED · DEC 8, 2026</p><h3 class="mt-4 text-xl font-semibold">v0.1.0 · The scanner</h3><p class="mt-3 text-sm leading-6 text-zinc-400">Runtime drift, native addons and Next.js 16 rules, npm and pnpm lockfiles, and terminal, Markdown, JSON and SARIF output.</p></div>
      <div class="glass-surface rounded-xl p-6" data-reveal><p class="font-mono text-xs text-amber-300">AFTER LAUNCH</p><h3 class="mt-4 text-xl font-semibold">More coverage</h3><p class="mt-3 text-sm leading-6 text-zinc-400">Yarn lockfiles, Node.js 24 and 26 code rules, deployment config, a packaged GitHub Action and multi-repository reports.</p></div>
      <div class="glass-surface rounded-xl p-6" data-reveal><p class="font-mono text-xs text-zinc-500">WITH DESIGN PARTNERS</p><h3 class="mt-4 text-xl font-semibold">Behavioral verification</h3><p class="mt-3 text-sm leading-6 text-zinc-400">Your own tests on the old and new versions, every difference labeled, and a record of what each upgrade changed.</p></div>
    </div>
  </section>

  <div class="stack-stage">
    <UpgradeAuditSection />
  </div>
</BaseLayout>


<style>
  .neukee-hero::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgba(212,212,212, .3) .75px, transparent .75px);
    background-size: 22px 22px;
    mask-image: linear-gradient(to right, transparent, black 35%, black 90%, transparent);
    content: "";
    pointer-events: none;
  }
  .hero-glow {
    background:
      radial-gradient(ellipse at 78% 45%, rgba(163,163,163, .2), transparent 42%),
      radial-gradient(ellipse at 17% 8%, rgba(163,163,163, .08), transparent 40%),
      linear-gradient(135deg, #0a0a0a 12%, #0c0c0c 58%, #111111);
  }
  .hero-float { animation: hero-drift 9s ease-in-out infinite; }
  @keyframes hero-drift { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
  @media (prefers-reduced-motion: reduce) { .hero-float { animation: none; } }
</style>
